# =====================================================================
# Production environment for docker-compose.prod.yml
#
# 1. cp .env.prod.example .env.prod
# 2. Fill in real values (especially APP_KEY, DB_PASSWORD,
#    MINIO_ROOT_PASSWORD, AWS_SECRET_ACCESS_KEY, REVERB_APP_SECRET, MAIL_*)
# 3. docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# Generate APP_KEY with:  php artisan key:generate --show
# =====================================================================

# ------------------------------------------------------------ application
APP_NAME=SocialNetwork
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://social.com
ASSET_URL=/
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
GUZZLE_VERIFY_SSL=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# --------------------------------------------------------------- database
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=SocialNetwork
DB_USERNAME=postgres
DB_PASSWORD=change-me

POSTGRES_DB=SocialNetwork
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# ---------------------------------------------------------- S3 / MinIO
MINIO_ROOT_USER=minio-root
MINIO_ROOT_PASSWORD=change-me

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=minio-root
AWS_SECRET_ACCESS_KEY=change-me
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=social-media
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=http://storage:9000
AWS_URL=http://storage:9000
AWS_PUBLIC_URL=/social-media

# ------------------------------------------------------------- sessions
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=social.com,www.social.com,app.social.com,api.social.com

# ---------------------------------------------------------------- queue
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------ reverb (websockets)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=0.0.0.0
REVERB_PORT=6001
REVERB_SCHEME=https

# Used ONLY at image build time (nginx build args).
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_HOST=https://social.com
VITE_REVERB_PORT=6001
VITE_REVERB_SCHEME=https

# ------------------------------------------------------------------ mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=change-me
MAIL_PASSWORD=change-me
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=change-me@example.com
MAIL_FROM_NAME="${APP_NAME}"

# ----------------------------------------------------------- OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://social.com/api/auth/google/callback

YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://social.com/auth/yandex/callback

# --------------------------------------------------------------- misc
FRONTEND_URL=https://social.com
TELESCOPE_ENABLED=false
